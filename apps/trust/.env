MINIO_ROOT_PASSWORD=substrate-secret
TRUST_PG_DSN=postgresql://substrate:substrate@localhost:5432/substrate
TRUST_MINIO_ENDPOINT=localhost:9000
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_SERVE_URL=http://localhost:8080
