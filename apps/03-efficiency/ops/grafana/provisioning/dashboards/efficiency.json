  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tier mix (requests/s by tier)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(substrate_routing_requests_total{tier!=\"total\"}[5m])",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Estimated cost/step by tier",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(substrate_routing_est_cost_usd_total[5m])) / clamp_min(sum(rate(substrate_routing_requests_total{tier!=\"total\"}[5m])), 1e-9)",
          "legendFormat": "cost/step",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit by region",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "sum(rate(substrate_cache_region_hit_total{state=\"hit\"}[5m])) by (region)",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p90 / p99 (routing)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(substrate_routing_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(substrate_routing_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(substrate_routing_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Budget burn (gate pass vs blow)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(substrate_budget_gate_total[5m])",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tiering cascade (escalate/reject per tier)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "rate(substrate_tier_verdict_total{verdict!=\"execute\"}[5m])",
          "legendFormat": "{{tier}}/{{verdict}}",
          "refId": "A"
        }
      ]
    }
  ],
